# Questions the node installer answers for this service — NOT settings. `# kind:` says who answers.

# Port this service listens on. The node assigns it from the block 24680-24699.
# kind: derived
PORT=

# Interface to bind. `127.0.0.1` — this machine only; the tunnel brings the public address.
# kind: derived
SERVICE_BIND=

# Public address of this registry as OTHER projects see it — it is printed into install instructions
# (`components.json` → registries → @fractera). Empty — http://localhost:<port>.
# kind: derived
SERVICE_PUBLIC_URL=

# The site's shell door (/api/shell) — header and footer of the project. The node installer gives it.
# kind: derived
PROJECT_SHELL_URL=

# Where the links of the header lead (the site). The node installer gives it.
# kind: derived
PROJECT_SITE_URL=

# Absolute path to this element's DESIGN-CONFIG/design-config.json — the project design it inherits.
# kind: derived
DESIGN_CONFIG_PATH=

# The key of the settings door (/api/settings/design): the node core presents it.
# kind: secret
SETTINGS_SECRET=

# The node core (architect pages): the landing links to the terminal of the Blocks section there (<url>/<lang>/blocks/terminal).
# kind: derived
ARCHITECT_URL=

# The node's settings element (step 308): this service takes the block settings (the design branch `blocks`) from it over
# MCP (<url>/mcp) at start and on its signal, with SETTINGS_SECRET. Empty — no such element: own DESIGN-CONFIG applies.
CONFIG_SERVICE_URL=
