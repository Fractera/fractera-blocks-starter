# Questions the node installer answers for this service — NOT settings. `# kind:` says who answers.

# Port this service listens on. The node assigns it from the block 24680-24699.
# kind: derived
PORT=

# Interface to bind. `127.0.0.1` — this machine only; the tunnel brings the public address.
# kind: derived
SERVICE_BIND=

# Public address of this registry as OTHER projects see it — it is printed into install instructions
# (`components.json` → registries → @fractera). Empty — http://localhost:<port>.
# kind: derived
SERVICE_PUBLIC_URL=

# The site's shell door (/api/shell) — header and footer of the project. The node installer gives it.
# kind: derived
PROJECT_SHELL_URL=

# Where the links of the header lead (the site). The node installer gives it.
# kind: derived
PROJECT_SITE_URL=
